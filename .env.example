# HelioScope AI — Environment Variables
# Copy this file to .env and fill in your values

# === AI (Gemini) ===
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=Your GEMINI key

# === Google Elevation API ===
# Get your key from https://console.cloud.google.com → Elevation API
GOOGLE_ELEVATION_API_KEY=Maps Evaluation  Key

# === JWT Authentication ===
JWT_SECRET_KEY=replace-with-a-long-random-string-in-production

# === Database (Optional — not required for initial setup) ===
DATABASE_URL=Your Database URL

# === Supabase (Recommended for production deploy) ===
# Supabase Postgres connection string
SUPABASE_URL=postgresql://postgres.xxxxx:your-password@aws-0-region.pooler.supabase.com:5432/postgres
# Optional direct Supabase client access
SUPABASE_URL_PUBLIC=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# === CORS (comma-separated) ===
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# === PostgreSQL (for docker-compose) ===
POSTGRES_USER=helioscope
POSTGRES_PASSWORD=Heli0$cope@i
POSTGRES_DB=helioscope

# === NASA EARTHDATA (MERRA-2 Wind Data) ===
# Optional: Get your credentials from https://urs.earthdata.nasa.gov/users/new
# Leave empty to use Open-Meteo for wind data (default)
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
# Set to 'true' to enable NASA MERRA-2 wind data integration
NASA_MERRA2_ENABLED=false
